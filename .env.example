# Host development configuration and Docker Compose interpolation source.
#
# In host mode, config/settings.py reads the repository .env with override=False,
# so variables already present in the process environment take precedence.
# In container modes, Python does not implicitly read /app/.env. Docker Compose may
# still read the host environment and repository .env, but only variables explicitly
# listed under a service's environment section are injected into that container.
DEPLOYMENT_MODE=host

# Compose host ports. Both containers still listen on port 8501 internally.
# Profiles are not mutually exclusive; keep distinct host ports when running both.
API_CPU_STREAMLIT_PORT=8501
GPU_STREAMLIT_PORT=8502

# External OpenAI-compatible DeepSeek API for host/API+CPU mode.
# Keep a real key only in the untracked .env, process environment, or a secret manager.
# Never commit a real key. An empty key is intentional here; api-cpu startup validation
# rejects it until Compose/secret injection supplies a value.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# All roles inherit the global provider, base URL, and API key above. Each role may
# override PROVIDER, MODEL, BASE_URL, API_KEY, timeout, temperature, or token limit.
PLANNER_LLM_MODEL=deepseek-chat
DRAFT_LLM_MODEL=deepseek-chat
AUDITOR_LLM_MODEL=deepseek-chat
JUDGE_LLM_MODEL=deepseek-chat

# Host-mode infrastructure. Compose containers use internal DNS names injected by
# docker-compose.yml instead of these loopback addresses.
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=regtech_compliance_chunks_v2
DATABASE_URL=postgresql+psycopg://regtech:change-me@127.0.0.1:5432/regtech
POSTGRES_PASSWORD=change-me

# Host-accessible CPU inference services from the api-cpu profile.
EMBEDDING_SERVICE_URL=http://localhost:8101
NLI_SERVICE_URL=http://localhost:8103
NLI_ENABLED=true
PREFER_LOCAL_INFERENCE_FALLBACK=false

# Default retrieval is hybrid dense+sparse RRF without reranking.
RERANKER_ENABLED=false
# Experimental only: start reranker-cpu from the tools profile before enabling.
# RERANKER_SERVICE_URL=http://localhost:8102

ORIGINAL_QUERY_RRF_WEIGHT=2.0
DENSE_RRF_WEIGHT=1.0
SPARSE_RRF_WEIGHT=1.0
RETRIEVAL_RERANK_SCORE_THRESHOLD=0.0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=2048

CHUNK_PARENT_TOKENS=1500
CHUNK_CHILD_TOKENS=400
CHUNK_OVERLAP_TOKENS=200
CHUNK_VERSION=semantic-v2
HYDE_SCORE_THRESHOLD=0.25
HYDE_MARGIN_THRESHOLD=0.05
NLI_ENTAILMENT_THRESHOLD=0.75
